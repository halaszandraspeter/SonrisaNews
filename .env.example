# Sonrisa News — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.

# ============================================================
# Bootstrap admin
# ============================================================
# The very first time the API starts, this user is created.
# They MUST change their password on first sign-in.
SEED_ADMIN_EMAIL=admin@sonrisa.local
SEED_ADMIN_PASSWORD=replace-me-with-a-strong-password
SEED_ADMIN_DISPLAY_NAME=Admin

# ============================================================
# Database
# ============================================================
# MVP: SQLite. Path is relative to the project root.
ConnectionStrings__Sonrisa=Data Source=data/sonrisa.db

# ============================================================
# JWT
# ============================================================
# 256-bit base64. Generate with: openssl rand -base64 32
Jwt__SigningKey=replace-me-with-a-256-bit-base64-secret
Jwt__Issuer=https://sonrisa.local
Jwt__Audience=sonrisa-web

# ============================================================
# SMTP (MailHog in dev; Resend / any SMTP in prod)
# ============================================================
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=noreply@sonrisa.local
Smtp__Username=
Smtp__Password=

# ============================================================
# yfinance sidecar
# ============================================================
Yfinance__BaseUrl=http://localhost:8001
Yfinance__TimeoutSeconds=10

# ============================================================
# Logging
# ============================================================
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning
